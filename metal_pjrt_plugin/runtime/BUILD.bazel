package(default_visibility = ["//visibility:public"])

METAL_LINKOPTS = [
    "-framework Metal",
    "-framework Foundation",
    "-framework QuartzCore",
]

cc_library(
    name = "metal_runtime",
    srcs = [
        "metal_cpp_impl.cc",
        "metal_runtime.cc",
        "system_memory.cc",
    ],
    hdrs = [
        "metal_runtime.h",
        "system_memory.h",
    ],
    linkopts = METAL_LINKOPTS,
    deps = [
        "@com_google_absl//absl/container:inlined_vector",
        "@com_google_absl//absl/log",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:status_macros",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/strings:str_format",
        "@com_google_absl//absl/types:span",
        "@metal_cpp",
    ],
)

cc_library(
    name = "constants_container",
    hdrs = ["constants_container.h"],
)

# Runtime test (no XLA); needs a Metal device, so run locally.
cc_test(
    name = "metal_runtime_test",
    srcs = ["metal_runtime_test.cc"],
    tags = [
        "local",
        "manual",
    ],
    deps = [
        ":metal_runtime",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:status_matchers",
        "@com_google_absl//absl/status:statusor",
        "@com_google_googletest//:gtest_main",
    ],
)

# CPU-side dispatch cost microbenchmark; needs a Metal device, run locally
# under scripts/device_lock.py.
cc_binary(
    name = "dispatch_bench",
    srcs = ["dispatch_bench.cc"],
    tags = ["manual"],
    deps = [
        ":metal_runtime",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@metal_cpp",
    ],
)

# Indirect command buffer spike (record/replay/update cost vs direct
# encoding); needs a Metal device, run under scripts/device_lock.py.
cc_binary(
    name = "icb_spike",
    srcs = ["icb_spike.cc"],
    tags = ["manual"],
    deps = [
        ":metal_runtime",  # metal-cpp private implementation
        "@metal_cpp",
    ],
)
