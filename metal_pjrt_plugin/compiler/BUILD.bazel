package(default_visibility = ["//visibility:public"])

# Compile-time settings, shared by the passes and the cache key
# (stream_executor:metal_executor).
cc_library(
    name = "compile_settings",
    srcs = ["compile_settings.cc"],
    hdrs = ["compile_settings.h"],
    deps = ["@com_google_absl//absl/strings"],
)

cc_library(
    name = "metal_compiler_impl",
    srcs = ["metal_compiler.cc"],
    hdrs = ["metal_compiler.h"],
    deps = [
        ":compile_settings",
        "//metal_pjrt_plugin/codegen:metal_kernel_compiler",
        "//metal_pjrt_plugin/codegen:msl_llvm_bridge",
        "//metal_pjrt_plugin/compiler/passes:dot_upcast",
        "//metal_pjrt_plugin/compiler/passes:hlo_checks",
        "//metal_pjrt_plugin/compiler/passes:scan_rewriter",
        "//metal_pjrt_plugin/compiler/passes:sort_expander",
        # linalg (Accelerate LAPACK): the rewriter and the handlers it targets.
        "//metal_pjrt_plugin/linalg:lapack_ffi",
        "//metal_pjrt_plugin/linalg:linalg_rewriter",
        "//metal_pjrt_plugin/runtime:constants_container",
        "//metal_pjrt_plugin/stream_executor:metal_platform_id",
        "@com_google_absl//absl/log",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@llvm-project//llvm:Core",
        "@xla//xla:shape_util",
        "@xla//xla:xla_proto_cc",
        "@xla//xla/hlo/ir:hlo",
        "@xla//xla/hlo/pass:hlo_pass_pipeline",
        "@xla//xla/hlo/transforms/simplifiers:hlo_dce",
        "@xla//xla/hlo/transforms/simplifiers:tuple_simplifier",
        "@xla//xla/service:call_inliner",
        "@xla//xla/service:topk_rewriter",
        "@xla//xla/service:dump",
        "@xla//xla/service:triangular_solve_expander",
        "@xla//xla/service:hlo_module_config",
        "@xla//xla/service/gpu:gpu_compiler",
        "@xla//xla/backends/gpu/codegen:kernel_compiler",
        "@xla//xla/service/gpu:target_constants",
        "@xla//xla/stream_executor:device_description",
        "@xla//xla/stream_executor:dnn",
        "@xla//xla/stream_executor:semantic_version",
        "@xla//xla/stream_executor:stream_executor_h",
        "@xla//xla/tsl/platform:env",
        "@xla//xla/tsl/platform:statusor",
    ],
)

cc_library(
    name = "metal_compiler",
    srcs = ["metal_compiler_registration.cc"],
    deps = [
        ":metal_compiler_impl",
        "//metal_pjrt_plugin/stream_executor:metal_platform_id",
        "@xla//xla/service:compiler",
    ],
    alwayslink = True,
)

cc_library(
    name = "metal_transfer_manager",
    srcs = ["metal_transfer_manager_registration.cc"],
    deps = [
        "//metal_pjrt_plugin/stream_executor:metal_platform_id",
        "@xla//xla/service:transfer_manager",
        "@xla//xla/service/gpu:gpu_transfer_manager",
    ],
    alwayslink = True,
)

cc_library(
    name = "metal_collectives",
    srcs = ["metal_collectives_registration.cc"],
    deps = [
        "//metal_pjrt_plugin/pjrt:metal_platform_name",
        "@xla//xla/backends/gpu/collectives:gpu_collectives_stub",
        "@xla//xla/core/collectives:collectives_registry",
    ],
    alwayslink = True,
)

cc_library(
    name = "metal_pjrt_compiler",
    srcs = ["metal_pjrt_compiler_registration.cc"],
    deps = [
        "//metal_pjrt_plugin/pjrt:metal_platform_name",
        "//metal_pjrt_plugin/stream_executor:metal_platform_id",
        "@com_google_absl//absl/log:check",
        "@xla//xla/pjrt:pjrt_compiler",
        "@xla//xla/pjrt/gpu:se_gpu_pjrt_compiler",
        "@xla//xla/pjrt/se:stream_executor_platform_id_mapping",
        "@xla//xla/stream_executor/platform:initialize",
    ],
    alwayslink = True,
)

cc_library(
    name = "ptx_custom_kernel_emitter_stub",
    srcs = ["ptx_custom_kernel_emitter_stub.cc"],
    deps = [
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@xla//xla/backends/gpu/runtime:thunk",
        "@xla//xla/hlo/ir:hlo",
    ],
    alwayslink = True,
)
