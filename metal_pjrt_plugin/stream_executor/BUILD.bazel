cc_library(
    name = "metal_platform",
    srcs = ["metal_platform.cc"],
    hdrs = ["metal_platform.h"],
    deps = [
        ":metal_executor",
        ":metal_platform_id",
        "//metal_pjrt_plugin/runtime:metal_runtime",
        "@com_google_absl//absl/log",
        "@com_google_absl//absl/log:check",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings:str_format",
        "@xla//xla/stream_executor:device_description",
        "@xla//xla/stream_executor:executor_cache",
        "@xla//xla/stream_executor:platform",
        "@xla//xla/stream_executor:platform_manager",
        "@xla//xla/stream_executor:stream_executor_h",
        "@xla//xla/stream_executor/platform:initialize",
    ],
    alwayslink = True,  # Registers itself with the PlatformManager.
)

cc_test(
