package(default_visibility = ["//visibility:public"])

cc_library(
    name = "metal_platform_name",
    hdrs = ["metal_platform_name.h"],
    deps = ["@xla//xla/pjrt:pjrt_compiler"],
)

# Everything that must be linked into the plugin for the Metal platform to be
# usable through XLA's stock GPU PJRT client and C API shim.
cc_library(
    name = "metal_plugin_deps",
    deps = [
        "//metal_pjrt_plugin/compiler:metal_collectives",
        "//metal_pjrt_plugin/compiler:metal_compiler",
        "//metal_pjrt_plugin/compiler:metal_pjrt_compiler",
        "//metal_pjrt_plugin/compiler:metal_transfer_manager",
        "//metal_pjrt_plugin/compiler:ptx_custom_kernel_emitter_stub",
        "//metal_pjrt_plugin/ffi:metal_ffi",
        "//metal_pjrt_plugin/stream_executor:metal_platform",
        "@xla//xla/backends/gpu/runtime:thunk_runtime_dependencies",
        "@xla//xla/service/gpu:gpu_compiler",
        "@xla//xla/service/gpu:gpu_executable",
        "@xla//xla/service/gpu:gpu_transfer_manager",
    ],
)

# The exported GetPjrtApi(): XLA's GPU C API shim (patched to report the
# "openmetal" platform on macOS) minus its PJRT_AbiVersion extension, so that
# jaxlib can serialize executables (persistent compilation cache), with
# BufferFromHostBuffer copying the caller's host data before returning, and
# with out-of-memory error messages carrying the runtime's reason.
cc_library(
    name = "metal_pjrt_api",
    srcs = ["metal_pjrt_api.cc"],
    deps = [
        "//metal_pjrt_plugin/runtime:metal_runtime",
        "@com_google_absl//absl/log:initialize",
        "@com_google_absl//absl/strings",
        "@tsl//tsl/platform:numbers",
        "@xla//xla:shape_util",
        "@xla//xla/pjrt/c:pjrt_c_api_gpu_internal",
        "@xla//xla/pjrt/c:pjrt_c_api_hdrs",
        "@xla//xla/pjrt/c:pjrt_c_api_helpers",
        "@xla//xla/pjrt/c:pjrt_c_api_macros",
    ],
    alwayslink = 1,
)

# The PJRT plugin shared library.
cc_binary(
    name = "pjrt_c_api_openmetal_plugin.dylib",
    linkopts = [
        "-Wl,-exported_symbol,_GetPjrtApi",
        # Host callbacks: jax_plugins/openmetal/callbacks.py installs its trampoline.
        "-Wl,-exported_symbol,_metal_pjrt_register_python_callback_trampoline",
        # Memory stats and the memory-pressure test hook (metal_runtime.cc).
        "-Wl,-exported_symbol,_metal_pjrt_memory_stats",
        "-Wl,-exported_symbol,_metal_pjrt_memory_pressure",
        "-Wl,-install_name,@rpath/pjrt_c_api_openmetal_plugin.dylib",
        "-Wl,-undefined,error",
    ],
    linkshared = True,
    deps = [
        ":metal_pjrt_api",
        ":metal_plugin_deps",
    ],
)
