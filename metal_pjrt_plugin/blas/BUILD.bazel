package(default_visibility = ["//visibility:public"])

# MPSMatrixMultiplication GEMM. Objective-C++ (ARC); the header is plain C++
# (absl only, no XLA). cc_library rejects the .mm extension, so the
# Objective-C++ sources are named *_objc.cc and -ObjC++ forces the language.
cc_library(
    name = "mps_gemm",
    srcs = ["mps_gemm_objc.cc"],
    hdrs = ["mps_gemm.h"],
    copts = [
        "-ObjC++",
        "-fobjc-arc",
    ],
    linkopts = [
        "-framework Metal",
        "-framework MetalPerformanceShaders",
        "-framework Foundation",
    ],
    deps = [
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:status_macros",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/strings:str_format",
    ],
)

# blas::BlasSupport + gpu::BlasLt for the Metal StreamExecutor.
cc_library(
    name = "metal_blas",
    srcs = ["metal_blas.cc"],
    hdrs = ["metal_blas.h"],
    deps = [
        ":mps_gemm",
        "//metal_pjrt_plugin/runtime:metal_runtime",
        "@com_google_absl//absl/log",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:status_macros",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@xla//xla:xla_data_proto_cc",
        "@xla//xla/stream_executor:blas",
        "@xla//xla/stream_executor:device_address",
        "@xla//xla/stream_executor:engine_options",
        "@xla//xla/stream_executor:scratch_allocator",
        "@xla//xla/stream_executor:stream",
        "@xla//xla/stream_executor/gpu:gpu_blas_lt",
    ],
)

# GEMM test (no XLA) against a CPU reference; needs a Metal device, so run
# locally.
cc_test(
    name = "mps_gemm_test",
    srcs = ["mps_gemm_test_objc.cc"],
    copts = [
        "-ObjC++",
        "-fobjc-arc",
    ],
    tags = [
        "local",
        "manual",
    ],
    deps = [
        ":mps_gemm",
        "//metal_pjrt_plugin/runtime:metal_runtime",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:status_matchers",
        "@com_google_absl//absl/status:statusor",
        "@com_google_googletest//:gtest_main",
    ],
)

# BlasLt epilogues through the Metal StreamExecutor; needs a Metal device.
cc_test(
