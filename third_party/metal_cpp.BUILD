# Apple's metal-cpp: header-only C++ bindings for Metal/Foundation/QuartzCore.
package(default_visibility = ["//visibility:public"])

cc_library(
    name = "metal_cpp",
    hdrs = glob(["**/*.hpp"]),
    includes = ["."],
)
