load("//metal_pjrt:device_test.bzl", "DEVICE_TEST_TAGS")

package(default_visibility = ["//visibility:public"])

METAL_LINKOPTS = [
    "-framework Metal",
    "-framework Foundation",
    "-framework QuartzCore",
]

cc_library(
    name = "env",
    srcs = ["env.cc"],
    hdrs = ["env.h"],
    deps = [
        "@com_google_absl//absl/log",
        "@com_google_absl//absl/strings",
    ],
)

cc_test(
    name = "env_test",
    srcs = ["env_test.cc"],
    deps = [
        ":env",
        "@com_google_googletest//:gtest_main",
    ],
)

cc_library(
    name = "metal_runtime",
    srcs = [
        "metal_cpp_impl.cc",
        "metal_runtime.cc",
        "system_memory.cc",
    ],
    hdrs = [
        "metal_runtime.h",
        "system_memory.h",
    ],
    linkopts = METAL_LINKOPTS,
    deps = [
        ":env",
        "//metal_pjrt/kernels:runtime_builtins",
        "@com_google_absl//absl/cleanup",
        "@com_google_absl//absl/container:flat_hash_map",
        "@com_google_absl//absl/container:inlined_vector",
        "@com_google_absl//absl/log",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:status_macros",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/strings:str_format",
        "@com_google_absl//absl/types:span",
        "@metal_cpp",
    ],
)

cc_library(
    name = "constants_container",
    hdrs = ["constants_container.h"],
)

# Runtime test (no XLA); needs a Metal device, so run locally.
cc_test(
    name = "metal_runtime_test",
    srcs = ["metal_runtime_test.cc"],
    tags = DEVICE_TEST_TAGS,
    timeout = "eternal",
    deps = [
        ":metal_runtime",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:status_matchers",
        "@com_google_absl//absl/status:statusor",
        "@com_google_googletest//:gtest_main",
    ],
)
