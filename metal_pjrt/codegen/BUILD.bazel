# MLIR -> EmitC -> Metal Shading Language kernel code generation.
package(default_visibility = ["//visibility:public"])

cc_library(
    name = "msl_kernel",
    hdrs = ["msl_kernel.h"],
    deps = ["//metal_pjrt/kernels:msl_prelude"],
)

cc_library(
    name = "msl_emitter",
    srcs = ["msl_emitter.cc"],
    hdrs = ["msl_emitter.h"],
    deps = [
        "//metal_pjrt/compiler:report_bug",
        ":msl_kernel",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:AffineToStandard",
        "@llvm-project//mlir:ArithDialect",
        "@llvm-project//mlir:ArithToEmitC",
        "@llvm-project//mlir:ArithTransforms",
        "@llvm-project//mlir:ComplexDialect",
        "@llvm-project//mlir:ComplexToStandard",
        "@llvm-project//mlir:DialectUtils",
        "@llvm-project//mlir:EmitCDialect",
        "@llvm-project//mlir:FuncDialect",
        "@llvm-project//mlir:FuncToEmitC",
        "@llvm-project//mlir:GPUDialect",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:LLVMDialect",
        "@llvm-project//mlir:MathDialect",
        "@llvm-project//mlir:Pass",
        "@llvm-project//mlir:SCFDialect",
        "@llvm-project//mlir:SCFToEmitC",
        "@llvm-project//mlir:Support",
        "@llvm-project//mlir:TargetCpp",
        "@llvm-project//mlir:TransformUtils",
        "@llvm-project//mlir:Transforms",
        "@llvm-project//mlir:UBDialect",
        "@llvm-project//mlir:VectorDialect",
        "@xla//xla/backends/gpu/codegen/emitters/transforms:passes",
        "@xla//xla/codegen/emitters/transforms:convert_pure_call_ops_pass",
        "@xla//xla/codegen/emitters/transforms:passes",
        "@xla//xla/codegen/emitters/transforms:simplify_affine_pass",
        "@xla//xla/codegen/emitters/transforms:simplify_arith_pass",
        "@xla//xla/stream_executor:device_description",
    ],
)

# Light-weight: used by the compiler's CompileTargetBinary.
cc_library(
    name = "msl_llvm_bridge",
    srcs = ["msl_llvm_bridge.cc"],
    hdrs = ["msl_llvm_bridge.h"],
    deps = [
        ":msl_kernel",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/strings",
        "@llvm-project//llvm:Core",
        "@llvm-project//llvm:Support",
    ],
)

# KernelCompiler that MetalCompiler returns from GpuCompiler::CreateKernelCompiler
# (added by third_party/xla/patches/0002-gpu-compiler-kernel-compiler-factory.patch).
cc_library(
    name = "metal_kernel_compiler",
    srcs = ["metal_kernel_compiler.cc"],
    hdrs = ["metal_kernel_compiler.h"],
    deps = [
        ":msl_emitter",
        ":msl_llvm_bridge",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@llvm-project//llvm:Core",
        "@llvm-project//llvm:OrcJIT",
        "@llvm-project//llvm:Support",
        "@llvm-project//llvm:TargetParser",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:Pass",
        "@llvm-project//mlir:TensorDialect",
        "@xla//xla:future",
        "@xla//xla:xla_proto_cc",
        "@xla//xla/backends/gpu/codegen:cubin_custom_kernel_compiler",
        "@xla//xla/backends/gpu/codegen:kernel_compiler",
        "@xla//xla/backends/gpu/codegen/emitters:mlir_kernel_emitter",
