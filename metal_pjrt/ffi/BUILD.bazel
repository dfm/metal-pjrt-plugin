load("//metal_pjrt:device_test.bzl", "DEVICE_TEST_TAGS")

package(default_visibility = ["//visibility:public"])

# XLA FFI support for the Metal platform: helpers plus the handlers the Metal
# compiler's scan rewriter targets (metal$scan), XLA's SortRewriter targets
# (xla.gpu.ext.cub_sort_keys/pairs) and the Python callback handler. Handlers register statically, so this is alwayslink.
cc_library(
    name = "metal_ffi",
    srcs = [
        "cub_sort_ffi.cc",
        "metal_ffi.cc",
        "python_callback_ffi.cc",
        "scan_ffi.cc",
    ],
    hdrs = ["metal_ffi.h"],
    deps = [
        ":radix_sort",
        ":scan",
        "//metal_pjrt/runtime:metal_runtime",
        "//metal_pjrt/stream_executor:metal_executor",
        "//metal_pjrt/stream_executor:metal_platform_id",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/strings:string_view",
        "@com_google_absl//absl/types:span",
        "@xla//xla:xla_data_proto_cc",
        "@xla//xla:shape_util",
        "@xla//xla/backends/gpu:ffi",
        "@xla//xla/ffi",
        "@xla//xla/ffi:ffi_api",
        "@xla//xla/stream_executor:platform",
        "@xla//xla/stream_executor:platform_manager",
        "@xla//xla/stream_executor:stream",
        "@xla//xla/stream_executor:stream_executor_h",
    ],
    alwayslink = True,
)

# The scan kernel's dispatch (metal$scan's handler is scan_ffi.cc). No XLA.
cc_library(
    name = "scan",
    srcs = ["scan.cc"],
    hdrs = ["scan.h"],
    deps = [
        "//metal_pjrt/compiler:report_bug",
        "//metal_pjrt/kernels:scan",
        "//metal_pjrt/runtime:kernel_launch",
        "//metal_pjrt/runtime:metal_runtime",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/strings:string_view",
    ],
)

# RunScan against a double reference, on rt::Device alone. Needs a Metal
# device.
cc_test(
    name = "scan_test",
    srcs = ["scan_test.cc"],
    tags = DEVICE_TEST_TAGS,
    timeout = "eternal",
    deps = [
        ":scan",
        "//metal_pjrt/runtime:metal_runtime",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:status_matchers",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_googletest//:gtest_main",
    ],
)

# The radix sort's plan and dispatch (the xla.gpu.ext.cub_sort_* handlers
# are cub_sort_ffi.cc). No XLA.
cc_library(
    name = "radix_sort",
    srcs = ["radix_sort.cc"],
    hdrs = ["radix_sort.h"],
    deps = [
        "//metal_pjrt/kernels:cub_sort",
        "//metal_pjrt/runtime:kernel_launch",
        "//metal_pjrt/runtime:metal_runtime",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/types:span",
    ],
)

# RunRadixSort against a CPU stable sort, bit for bit, on rt::Device alone.
# Needs a Metal device.
cc_test(
    name = "radix_sort_test",
    srcs = ["radix_sort_test.cc"],
    tags = DEVICE_TEST_TAGS,
    timeout = "eternal",
    deps = [
        ":radix_sort",
        "//metal_pjrt/runtime:metal_runtime",
        "@com_google_absl//absl/cleanup",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:status_matchers",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_googletest//:gtest_main",
    ],
)
