load("//metal_pjrt:device_test.bzl", "DEVICE_TEST_TAGS")
load(":embed_msl.bzl", "embed_msl")

package(default_visibility = ["//visibility:public"])

# The hand-written Metal Shading Language, embedded in the dylib as char
# arrays (embed_msl.bzl) and compiled at run time. Nothing here is shipped as
# a separate file.

embed_msl(
    name = "conv_misc",
    src = "conv_misc.metal",
    symbol = "kConvMiscMsl",
)

embed_msl(
    name = "cub_sort",
    src = "cub_sort.metal",
    symbol = "kCubSortMsl",
)

embed_msl(
    name = "mps_staging",
    src = "mps_staging.metal",
    symbol = "kMpsStagingMsl",
)

# Prepended to every kernel the MSL emitter generates (codegen/).
embed_msl(
    name = "msl_prelude",
    src = "msl_prelude.metal",
    symbol = "kMslPrelude",
)

embed_msl(
    name = "runtime_builtins",
    src = "runtime_builtins.metal",
    symbol = "kRuntimeBuiltinsMsl",
)

embed_msl(
    name = "scan",
    src = "scan.metal",
    symbol = "kScanMsl",
)

embed_msl(
    name = "small_linalg",
    src = "small_linalg.metal",
    symbol = "kSmallLinalgMsl",
)

embed_msl(
    name = "steel_conv",
    src = "steel_conv.metal",
    symbol = "kSteelConvMsl",
)

embed_msl(
    name = "steel_gemm",
    src = "steel_gemm.metal",
    symbol = "kSteelGemmMsl",
)

# Compiles every source and creates a pipeline for every kernel the plugin
# can ask for. Needs a Metal device.
cc_test(
    name = "kernels_test",
    srcs = ["kernels_test.cc"],
    tags = DEVICE_TEST_TAGS,
    timeout = "eternal",
    deps = [
        ":conv_misc",
        ":cub_sort",
        ":mps_staging",
        ":msl_prelude",
        ":runtime_builtins",
        ":scan",
        ":small_linalg",
        ":steel_conv",
        ":steel_gemm",
        "//metal_pjrt/blas:mps_gemm",
        "//metal_pjrt/blas:steel_gemm",
        "//metal_pjrt/conv:conv_kernels",
        "//metal_pjrt/runtime:metal_runtime",
        "@com_google_absl//absl/status:status_matchers",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/types:span",
        "@com_google_googletest//:gtest_main",
        "@metal_cpp",
    ],
)
