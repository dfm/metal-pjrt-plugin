load("@rules_python//python:defs.bzl", "py_test")

# Pinned XLA sources snapshotted by tripwire.py (see its docstring). Files in
# packages whose default visibility hides them (xla/pjrt/gpu) can't be listed;
# tripwire.py reads those next to the listed ones (INVISIBLE there).
filegroup(
    name = "xla_sources",
    srcs = [
        "@xla//xla/backends/gpu/codegen/emitters:mlir_kernel_emitter.cc",
        "@xla//xla/backends/gpu/codegen/emitters:transpose.cc",
        "@xla//xla/backends/gpu/transforms:gemm_rewriter.cc",
        "@xla//xla/backends/gpu/transforms:priority_fusion.cc",
        "@xla//xla/backends/gpu/transforms:topk_specializer.cc",
        "@xla//xla/codegen/emitters:elemental_hlo_to_mlir.cc",
        "@xla//xla/codegen/emitters/transforms:lower_tensors.cc",
        "@xla//xla/codegen/emitters/transforms:vectorize_loads_stores.cc",
        "@xla//xla/service:algorithm_util.cc",
        "@xla//xla/service/gpu:gpu_compiler.cc",
        "@xla//xla/service/gpu:matmul_utils.cc",
        "@xla//xla/hlo/transforms/expanders:cholesky_expander.cc",
        "@xla//xla/stream_executor/integrations:tf_allocator_adapter.cc",
        "@xla//xla/backends/gpu/transforms:sort_rewriter.cc",
        "@xla//xla/pjrt/c:pjrt_c_api_gpu_internal.cc",
        "@xla//xla/pjrt/c_api_client:pjrt_c_api_client.cc",
        "@xla//xla/pjrt/se:buffer_sequencing_event.cc",
        "@xla//xla/pjrt/se:pjrt_stream_executor_client.cc",
        "@xla//xla/pjrt/se:stream_executor_executable.cc",
        "@xla//xla/python/pjrt_ifrt:pjrt_executable.cc",
    ],
)

py_test(
    name = "xla_tripwire_test",
    srcs = ["tripwire.py"],
    args = [
        "--golden",
        "$(rootpath golden.txt)",
        "$(rootpaths :xla_sources)",
    ],
    data = [
        "golden.txt",
        ":xla_sources",
    ],
    main = "tripwire.py",
    # tripwire.py also reads INVISIBLE files that are not declared inputs, so
    # a cached PASS could hide a change to them (e.g. from our XLA patches).
    tags = ["external"],
)
