cc_library(
    name = "blas_lt_support",
    srcs = ["blas_lt_support.cc"],
    hdrs = ["blas_lt_support.h"],
    deps = [
        "//metal_pjrt/compiler:report_bug",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:status_macros",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@xla//xla:shape_util",
        "@xla//xla:xla_data_proto_cc",
        "@xla//xla/stream_executor:blas",
        "@xla//xla/stream_executor/gpu:gpu_blas_lt",
    ],
)

# blas::BlasSupport + gpu::BlasLt for the Metal StreamExecutor.
cc_library(
