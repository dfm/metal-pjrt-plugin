# MPS (f32) GEMM test (no XLA) against a CPU reference; needs a Metal
# device, so run locally.
cc_test(
    name = "mps_gemm_test",
    srcs = ["mps_gemm_test_objc.cc"],
    copts = [
        "-ObjC++",
        "-fobjc-arc",
    ],
    tags = DEVICE_TEST_TAGS,
    timeout = "eternal",
    deps = [
        ":mps_gemm",
        "//metal_pjrt/runtime:metal_runtime",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:status_matchers",
        "@com_google_absl//absl/status:statusor",
        "@com_google_googletest//:gtest_main",
    ],
)

