load("//metal_pjrt:device_test.bzl", "DEVICE_TEST_TAGS")

package(default_visibility = ["//visibility:public"])

# MPSMatrixMultiplication GEMM. Objective-C++ (ARC); the header is plain C++
# (absl only, no XLA). cc_library rejects the .mm extension, so the
# Objective-C++ sources are named *_objc.cc and -ObjC++ forces the language.
cc_library(
    name = "mps_gemm",
    srcs = ["mps_gemm_objc.cc"],
    hdrs = ["mps_gemm.h"],
    copts = [
        "-ObjC++",
        "-fobjc-arc",
    ],
    linkopts = [
        "-framework Metal",
        "-framework MetalPerformanceShaders",
        "-framework Foundation",
    ],
    deps = [
        "//metal_pjrt/kernels:mps_staging",
        "//metal_pjrt/runtime:metal_runtime",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:status_macros",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/strings:str_format",
    ],
)

# What MetalBlasLt supports (ValidateMatmul), without Metal; also used by
