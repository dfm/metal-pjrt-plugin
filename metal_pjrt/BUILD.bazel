load("@rules_python//python:defs.bzl", "py_test")

# Plugin sources; each subdirectory is its own package:
#
#   runtime/           XLA-free layer over Metal (metal-cpp)
#   stream_executor/   MetalPlatform, MetalExecutor, MetalStream, MetalEvent
#   compiler/          MetalCompiler : xla::gpu::GpuCompiler, HLO passes
#   codegen/           MLIR -> EmitC -> MSL (MetalKernelCompiler)
#   blas/, linalg/     GEMM (MPS, steel) and linear algebra
#   conv/, fft/        convolutions and FFTs (MLX's kernels)
#   ffi/               FFI custom-call handlers
#                      (ffi:scan, ffi:radix_sort, linalg:small_linalg and
#                      linalg:lapack_host are the XLA-free work behind them)
#   kernels/           hand-written MSL (.metal), embedded in the dylib
#   pjrt/              the plugin dylib (XLA's GPU C API shim, own GetPjrtApi)

# The dispatch libraries' tests link no XLA and the host tests no Metal
# (xla_free_test.py). genquery takes no wildcards, so the test filters the
# transitive deps by repository.
HOST_TESTS = [
    "//metal_pjrt/fft:fft_plan_test",
    "//metal_pjrt/linalg:lapack_host_test",
]

DISPATCH_TESTS = HOST_TESTS + [
    "//metal_pjrt/conv:conv_test",
    "//metal_pjrt/ffi:radix_sort_test",
    "//metal_pjrt/ffi:scan_test",
    "//metal_pjrt/fft:fft_test",
    "//metal_pjrt/linalg:small_linalg_test",
]

genquery(
    name = "dispatch_test_deps",
    expression = "deps(" + " + ".join(DISPATCH_TESTS) + ")",
    scope = DISPATCH_TESTS,
)

genquery(
    name = "host_test_deps",
    expression = "deps(" + " + ".join(HOST_TESTS) + ")",
    scope = HOST_TESTS,
)

genquery(
    name = "host_test_metal_linkopts",
    expression = "attr(linkopts, 'framework (Metal|QuartzCore)', " +
                 "deps(" + " + ".join(HOST_TESTS) + "))",
    scope = HOST_TESTS,
)

# Control: the pattern must still match XLA labels.
genquery(
    name = "metal_ffi_direct_deps",
    expression = "deps(//metal_pjrt/ffi:metal_ffi, 1)",
    scope = ["//metal_pjrt/ffi:metal_ffi"],
)

py_test(
    name = "xla_free_test",
    srcs = ["xla_free_test.py"],
    args = [
        "$(rootpath :dispatch_test_deps)",
        "$(rootpath :host_test_deps)",
        "$(rootpath :host_test_metal_linkopts)",
        "$(rootpath :metal_ffi_direct_deps)",
    ],
    data = [
        ":dispatch_test_deps",
        ":host_test_deps",
        ":host_test_metal_linkopts",
        ":metal_ffi_direct_deps",
    ],
)

# Tests that need a Metal device (tagged manual, so `//...` skips them; see
# device_test.bzl). A test_suite only picks up manual tests listed here by
# name, so list every one:
#   scripts/device_lock.py -- bazel test //metal_pjrt:device_tests
test_suite(
    name = "device_tests",
    tags = ["manual"],
    tests = [
        "//metal_pjrt/blas:metal_blas_lt_test",
        "//metal_pjrt/blas:mps_gemm_test",
        "//metal_pjrt/blas:steel_gemm_test",
        "//metal_pjrt/conv:conv_test",
        "//metal_pjrt/ffi:radix_sort_test",
        "//metal_pjrt/ffi:scan_test",
        "//metal_pjrt/fft:fft_test",
        "//metal_pjrt/kernels:kernels_test",
        "//metal_pjrt/linalg:small_linalg_test",
        "//metal_pjrt/runtime:metal_runtime_test",
        "//metal_pjrt/stream_executor:metal_executor_test",
    ],
)
