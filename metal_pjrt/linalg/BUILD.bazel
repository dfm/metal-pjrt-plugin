load("//metal_pjrt:device_test.bzl", "DEVICE_TEST_TAGS")

package(default_visibility = ["//visibility:public"])

# Cholesky, triangular solve and LU of matrices of up to 32 rows/cols on the
# GPU, one thread per matrix. No XLA.
cc_library(
    name = "small_linalg",
    srcs = ["small_linalg.cc"],
    hdrs = ["small_linalg.h"],
    deps = [
        "//metal_pjrt/kernels:small_linalg",
        "//metal_pjrt/runtime:kernel_launch",
        "//metal_pjrt/runtime:metal_runtime",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
    ],
)

# The small kernels against double references, on rt::Device alone. Needs a
# Metal device.
cc_test(
    name = "small_linalg_test",
    srcs = ["small_linalg_test.cc"],
    tags = DEVICE_TEST_TAGS,
    timeout = "eternal",
    deps = [
        ":small_linalg",
        "//metal_pjrt/runtime:metal_runtime",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:status_matchers",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_googletest//:gtest_main",
    ],
)

# The Accelerate LAPACK/BLAS calls behind the handlers, on host pointers.
# No XLA, no Metal.
cc_library(
    name = "lapack_host",
    srcs = ["lapack_host.cc"],
    hdrs = ["lapack_host.h"],
    linkopts = ["-framework Accelerate"],
    deps = [
        "//metal_pjrt/compiler:report_bug",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
    ],
)

# lapack_host against reconstruction residuals. A host test (runs in //...).
cc_test(
    name = "lapack_host_test",
    srcs = ["lapack_host_test.cc"],
    deps = [
        ":lapack_host",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:status_matchers",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_googletest//:gtest_main",
    ],
)

# Dense linear algebra via Apple Accelerate (LAPACK/BLAS on the CPU, zero
# copy on unified memory): FFI handlers plus the HLO pass that targets them.
# See lapack_ffi.cc. Handlers register statically, so this is alwayslink.
cc_library(
    name = "lapack_ffi",
    srcs = ["lapack_ffi.cc"],
    deps = [
        ":lapack_host",
        ":small_linalg",
        "//metal_pjrt/ffi:metal_ffi",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/types:span",
        "@xla//xla:xla_data_proto_cc",
        "@xla//xla/backends/gpu:ffi",
        "@xla//xla/ffi",
        "@xla//xla/ffi:ffi_api",
        "@xla//xla/stream_executor:stream",
    ],
    alwayslink = True,
)

cc_library(
    name = "linalg_rewriter",
    srcs = ["linalg_rewriter.cc"],
    hdrs = ["linalg_rewriter.h"],
    deps = [
        "//metal_pjrt/compiler:compile_settings",
        "@com_google_absl//absl/container:flat_hash_set",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/strings:string_view",
        "@xla//xla:shape_util",
        "@xla//xla:xla_data_proto_cc",
        "@xla//xla/hlo/ir:hlo",
        "@xla//xla/hlo/pass:hlo_pass",
        "@xla//xla/service/gpu:backend_configs_cc",
        "@xla//xla/tsl/platform:errors",
    ],
)
